# Copy this to `.env` ON THE EC2 BOX and fill in real values.
# This file (the .example) is safe to commit; the real .env is gitignored.

# The image you pushed to Docker Hub (Step 3). Example: dakshh18/landed-backend:latest
BACKEND_IMAGE=YOUR_DOCKERHUB_USERNAME/landed-backend:latest

# The domain Caddy will get an HTTPS cert for (Step 7). Example: landed-ca.duckdns.org
API_DOMAIN=your-api-domain-here

# Neon Postgres connection string (Step 4). Use the POOLED endpoint, keep sslmode=require.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/landed?sslmode=require

# Secrets
OPENAI_API_KEY=sk-replace-me
TAVILY_API_KEY=tvly-replace-me

# The deployed frontend origin (Step 8) so CORS allows it. Example: https://landed-ca.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# Optional tuning (defaults are fine)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
RETRIEVAL_K=8
REFUSE_THRESHOLD=0.015
MAX_TOOL_CALLS=4
