{
  "name": "landed-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Landed — Agentic RAG assistant for Canadian newcomers (Phase 1: data layer + retrieval).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "ingest": "tsx src/ingestion/ingest.ts",
    "retrieve": "tsx src/retrieval/cli.ts",
    "chat": "tsx src/dev/chat-client.ts",
    "eval": "tsx src/eval/run-eval.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "openai": "^4.65.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
